# Spotify Developer Credentials (OPTIONAL - NOT REQUIRED)
# You do NOT need Spotify Premium or Developer Keys.
# SpotDown operates in Zero-Config mode automatically.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Redirect URI (Optional, only for Spotify OAuth)
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=http://localhost:3000/callback

# Download Worker API URL
NEXT_PUBLIC_WORKER_API_URL=http://localhost:3001
